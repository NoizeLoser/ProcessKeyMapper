
# Normalize text files to LF in the repository.
* text=auto

# C/C++ source files
*.c     text eol=lf
*.cc    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.inl   text eol=lf

# Visual Studio project and solution files
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.filters  text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf

# Configuration and documentation
*.ini  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.exe  binary
*.dll  binary
*.lib  binary
*.obj  binary
*.pdb  binary
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.zip  binary
